# Local profile variables. Copy to .env (git-ignored) and adjust; scripts/smoke-local.sh creates
# one for itself when none exists. Placeholders only: never commit a real host or token.

# Postgres
POSTGRES_DB=omnigent
POSTGRES_USER=omnigent
POSTGRES_PASSWORD=change-me-local

# Published ports (bound to 127.0.0.1 only)
OMNIGENT_PORT=8000
ROUTER_PORT=4000
STUB_PORT=8080
DEX_PORT=5556

# OIDC (dex dev provider). Mint the two secrets with: openssl rand -hex 32
OMNIGENT_OIDC_CLIENT_ID=omnigent-local
OMNIGENT_OIDC_CLIENT_SECRET=change-me-local-client-secret
OMNIGENT_OIDC_COOKIE_SECRET=change-me-local-cookie-secret-0123456789abcdef

# Model routes: both point at the local stub by default (no Databricks, no paid call).
FORGE_DEFAULT_BASE_URL=http://stub:8080/v1
FORGE_DEFAULT_MODEL=system.ai.deepseek-v4-1-flash-1017
FORGE_DEFAULT_TOKEN=stub-token
FORGE_ESCALATION_BASE_URL=http://stub:8080/v1
FORGE_ESCALATION_MODEL=databricks-claude-opus-5-5
FORGE_ESCALATION_TOKEN=stub-token
STUB_TOKEN=stub-token

# Live Unity Gateway route (config only; supply the token from your shell or .env, never commit it):
# FORGE_DEFAULT_BASE_URL=https://<workspace>/ai-gateway/mlflow/v1
# FORGE_DEFAULT_TOKEN=<workspace-token>
# FORGE_ESCALATION_BASE_URL=https://<workspace>/serving-endpoints
# FORGE_ESCALATION_TOKEN=<workspace-token>
