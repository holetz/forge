# Local profile variables. Copy to .env (git-ignored) and adjust; scripts/smoke-local.sh creates
# one for itself when none exists. Placeholders only: never commit a real host or token.

# Postgres
POSTGRES_DB=omnigent
POSTGRES_USER=omnigent
POSTGRES_PASSWORD=change-me-local

# Published ports (bound to 127.0.0.1 only). OMNIGENT_PORT, DEX_PORT and OMNIGENT_OIDC_CLIENT_ID
# may be overridden: they flow into dex's issuer, redirect URI and client id.
OMNIGENT_PORT=8000
ROUTER_PORT=4000
STUB_PORT=8080
DEX_PORT=5556

# OIDC (dex dev provider). Mint both secrets with `openssl rand -hex 32` (the cookie secret needs 64 hex chars).
OMNIGENT_OIDC_CLIENT_ID=omnigent-local
OMNIGENT_OIDC_CLIENT_SECRET=change-me-local-client-secret
OMNIGENT_OIDC_COOKIE_SECRET=change-me-local-cookie-secret-0123456789abcdef

# Model routes: both point at the local stub by default (no Databricks, no paid call).
FORGE_DEFAULT_BASE_URL=http://stub:8080/v1
FORGE_DEFAULT_MODEL=system.ai.deepseek-v4-1-flash-1017
FORGE_DEFAULT_TOKEN=stub-token
FORGE_ESCALATION_BASE_URL=http://stub:8080/v1
FORGE_ESCALATION_MODEL=databricks-claude-opus-5-5
FORGE_ESCALATION_TOKEN=stub-token
STUB_TOKEN=stub-token

# Live Unity Gateway route (config only; supply the token from your shell or .env, never commit it):
# FORGE_DEFAULT_BASE_URL=https://<workspace>/ai-gateway/mlflow/v1
# FORGE_DEFAULT_TOKEN=<workspace-token>
# FORGE_ESCALATION_BASE_URL=https://<workspace>/serving-endpoints
# FORGE_ESCALATION_TOKEN=<workspace-token>

# Server profile (compose.server.yaml). The egress gateway is the only service that holds upstream
# tokens; by default every upstream is the local stub. Unset base URL = upstream disabled (503).
# Shared by the router and the gateway only: the router signs the audit identity, the gateway verifies it.
# Empty = every audit record is `unauthenticated`. Generate one with `openssl rand -hex 32` (at least 32 chars).
EGRESS_IDENTITY_SECRET=
EGRESS_PLAIN_HTTP_HOSTS=stub
EGRESS_MODELS_DEFAULT_BASE_URL=http://stub:8080/v1
EGRESS_MODELS_DEFAULT_TOKEN=stub-token
EGRESS_MODELS_ESCALATION_BASE_URL=http://stub:8080/v1
EGRESS_MODELS_ESCALATION_TOKEN=stub-token
# EGRESS_GIT_BASE_URL=https://<git-host>
# EGRESS_GIT_TOKEN=<git-token>
# EGRESS_MCP_CATALOG_BASE_URL=https://<mcp-host>
# EGRESS_MCP_CATALOG_TOKEN=<mcp-token>
