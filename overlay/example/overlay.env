# Synthetic example overlay for a fictional "Example Corp". Every host is reserved (example.com);
# every credential is empty or a placeholder and comes from the shell or a secret store.
OVERLAY_DIR=./overlay/example
OVERLAY_OIDC_ISSUER=https://idp.example.com/realms/example
OMNIGENT_OIDC_CLIENT_ID=forge-example
OMNIGENT_OIDC_CLIENT_SECRET=<supplied-from-the-shell>
OMNIGENT_OIDC_COOKIE_SECRET=<supplied-from-the-shell>
EGRESS_MODELS_DEFAULT_BASE_URL=https://models.example.com/v1
EGRESS_MODELS_DEFAULT_TOKEN=
EGRESS_MODELS_ESCALATION_BASE_URL=https://models.example.com/v1
EGRESS_MODELS_ESCALATION_TOKEN=
EGRESS_PLAIN_HTTP_HOSTS=
EGRESS_GIT_BASE_URL=https://git.example.com
EGRESS_GIT_TOKEN=
EGRESS_MCP_CATALOG_BASE_URL=https://catalog.example.com
EGRESS_MCP_CATALOG_TOKEN=
